rules_version = '2';
// ふたりの家計簿 — Firestore セキュリティルール
// ・家計簿(households/{roomId})は、合言葉から計算したIDを知っている人だけが開ける
// ・メンバーは2人まで。メンバー以外は中のデータ(設定・支出)を読み書きできない
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function room(roomId) { return get(/databases/$(database)/documents/households/$(roomId)).data; }
    function isMember(roomId) { return signedIn() && request.auth.uid in room(roomId).members; }

    match /households/{roomId} {
      // IDを正確に知っている場合だけ取得できる。一覧の取得は禁止
      allow get: if signedIn();
      allow list: if false;

      // 作成: 作った本人だけがメンバー
      allow create: if signedIn()
        && request.resource.data.members == [request.auth.uid];

      allow update: if signedIn() && request.resource.data.members.size() <= 2 && (
        // メンバーは更新できる(相手を外す・呼び名の登録など)
        request.auth.uid in resource.data.members
        ||
        // メンバー以外は「自分を1人追加する」ことだけできる(2人まで)
        (
          !(request.auth.uid in resource.data.members)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
          && request.resource.data.members.size() == resource.data.members.size() + 1
          && request.resource.data.members.hasAll(resource.data.members)
          && request.auth.uid in request.resource.data.members
        )
      );

      allow delete: if signedIn() && request.auth.uid in resource.data.members;

      // 設定・支出など中身はメンバーだけ
      match /{sub=**} {
        allow read, write: if isMember(roomId);
      }
    }
  }
}
